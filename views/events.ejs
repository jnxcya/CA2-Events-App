<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Browse Gaming Events</title>

    <link rel="stylesheet" href="/css/stylesheet.css">
</head>

<body>

    <nav>
        <a class="brand" href="/">Gaming Event Planner</a>

        <div class="links">
            <a href="/events">Browse Events</a>

            <% if (user) { %>
                <a href="/events/add">Create Event</a>
                <a href="/my-events">My Events</a>
                <a href="/joined-events">Joined Events</a>
                <a href="/dashboard">Dashboard</a>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </div>
    </nav>

    <main class="container">

        <h1>Browse Gaming Events</h1>

        <p class="page-description">
            Find gaming tournaments, ranked sessions,
            casual matches and training activities.
        </p>

        <% if (success === 'joined') { %>
            <div class="message success-message">
                You successfully joined the event.
            </div>
        <% } %>

        <% if (success === 'left') { %>
            <div class="message success-message">
                You successfully left the event.
            </div>
        <% } %>

        <% if (success === 'created') { %>
            <div class="message success-message">
                Your event was created successfully.
            </div>
        <% } %>

        <% if (success === 'updated') { %>
            <div class="message success-message">
                Your event was updated successfully.
            </div>
        <% } %>

        <% if (success === 'deleted') { %>
            <div class="message success-message">
                Your event was deleted.
            </div>
        <% } %>

        <% if (error === 'full') { %>
            <div class="message error-message">
                This event is already full.
            </div>
        <% } %>

        <% if (error === 'alreadyJoined') { %>
            <div class="message error-message">
                You have already joined this event.
            </div>
        <% } %>

        <% if (error === 'eventNotFound') { %>
            <div class="message error-message">
                The selected event could not be found.
            </div>
        <% } %>

        <% if (error === 'notAllowed') { %>
            <div class="message error-message">
                You can only edit or delete events that you created.
            </div>
        <% } %>

        <form
            class="search-form"
            action="/events"
            method="GET"
        >
            <input
                type="text"
                name="search"
                placeholder="Search by event title or game"
                value="<%= search || '' %>"
            >

            <select name="platform">
                <option value="">All Platforms</option>

                <option
                    value="PC"
                    <%= platform === 'PC' ? 'selected' : '' %>
                >
                    PC
                </option>

                <option
                    value="PlayStation"
                    <%= platform === 'PlayStation'
                        ? 'selected'
                        : ''
                    %>
                >
                    PlayStation
                </option>

                <option
                    value="Xbox"
                    <%= platform === 'Xbox'
                        ? 'selected'
                        : ''
                    %>
                >
                    Xbox
                </option>

                <option
                    value="Mobile"
                    <%= platform === 'Mobile'
                        ? 'selected'
                        : ''
                    %>
                >
                    Mobile
                </option>

                <option
                    value="Nintendo Switch"
                    <%= platform === 'Nintendo Switch'
                        ? 'selected'
                        : ''
                    %>
                >
                    Nintendo Switch
                </option>
            </select>

            <select name="eventType">
                <option value="">All Event Types</option>

                <option
                    value="Tournament"
                    <%= eventType === 'Tournament'
                        ? 'selected'
                        : ''
                    %>
                >
                    Tournament
                </option>

                <option
                    value="Ranked"
                    <%= eventType === 'Ranked'
                        ? 'selected'
                        : ''
                    %>
                >
                    Ranked Session
                </option>

                <option
                    value="Casual"
                    <%= eventType === 'Casual'
                        ? 'selected'
                        : ''
                    %>
                >
                    Casual Match
                </option>

                <option
                    value="Training"
                    <%= eventType === 'Training'
                        ? 'selected'
                        : ''
                    %>
                >
                    Training Session
                </option>
            </select>

            <button
                class="button primary-button"
                type="submit"
            >
                Search
            </button>

            <a
                class="button secondary-button"
                href="/events"
            >
                Clear
            </a>
        </form>

        <% if (!events || events.length === 0) { %>

            <div class="no-events">
                <h2>No events found</h2>

                <p>
                    Try using another keyword or changing
                    the selected filters.
                </p>
            </div>

        <% } else { %>

            <section class="events-grid">

                <% events.forEach(event => { %>

                    <article class="event-card">

                        <span class="event-type">
                            <%= event.eventType %>
                        </span>

                        <h2><%= event.title %></h2>

                        <p>
                            <strong>Game:</strong>
                            <%= event.gameName %>
                        </p>

                        <p>
                            <strong>Platform:</strong>
                            <%= event.platform %>
                        </p>

                        <p>
                            <strong>Date:</strong>

                            <%= new Date(
                                event.eventDate
                            ).toLocaleDateString('en-SG') %>
                        </p>

                        <p>
                            <strong>Time:</strong>
                            <%= event.eventTime %>
                        </p>

                        <p>
                            <strong>Location/Server:</strong>
                            <%= event.location || 'Not specified' %>
                        </p>

                        <p>
                            <strong>Players:</strong>
                            <%= event.currentPlayers %>
                            /
                            <%= event.maxPlayers %>
                        </p>

                        <% if (event.description) { %>
                            <p>
                                <strong>Description:</strong>
                                <%= event.description %>
                            </p>
                        <% } %>

                        <div class="event-actions">

                            <% if (!user) { %>

                                <a
                                    class="button primary-button"
                                    href="/login"
                                >
                                    Login to Join
                                </a>

                            <% } else if (event.hasJoined) { %>

                                <form
                                    action="/events/<%= event.eventId %>/leave"
                                    method="POST"
                                >
                                    <button
                                        class="button leave-button"
                                        type="submit"
                                    >
                                        Leave Event
                                    </button>
                                </form>

                            <% } else if (
                                Number(event.currentPlayers) >=
                                Number(event.maxPlayers)
                            ) { %>

                                <button
                                    class="button disabled-button"
                                    type="button"
                                    disabled
                                >
                                    Event Full
                                </button>

                            <% } else { %>

                                <form
                                    action="/events/<%= event.eventId %>/join"
                                    method="POST"
                                >
                                    <button
                                        class="button join-button"
                                        type="submit"
                                    >
                                        Join Event
                                    </button>
                                </form>

                            <% } %>

                            <%
                                /*
                                 * Edit and delete are only offered to the
                                 * user who created the event, or to an
                                 * administrator.
                                 */
                            %>
                            <% if (user && (event.createdBy === user.userId || user.role === 'admin')) { %>

                                <a
                                    class="button secondary-button"
                                    href="/events/<%= event.eventId %>/edit"
                                >
                                    Edit
                                </a>

                                <form
                                    action="/events/<%= event.eventId %>/delete"
                                    method="POST"
                                    onsubmit="return confirm('Delete this event? This cannot be undone.');"
                                >
                                    <button
                                        class="button leave-button"
                                        type="submit"
                                    >
                                        Delete
                                    </button>
                                </form>

                            <% } %>

                        </div>

                    </article>

                <% }) %>

            </section>

        <% } %>

    </main>

</body>
</html>
