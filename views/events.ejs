<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Browse Gaming Events</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            color: #222;
        }

        nav {
            background-color: #1d1d2f;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav .brand {
            color: white;
            font-size: 22px;
            font-weight: bold;
            text-decoration: none;
        }

        nav .links {
            display: flex;
            gap: 18px;
            align-items: center;
        }

        nav .links a {
            color: white;
            text-decoration: none;
        }

        nav .links a:hover {
            text-decoration: underline;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 30px auto;
        }

        h1 {
            margin-bottom: 8px;
        }

        .page-description {
            color: #555;
            margin-top: 0;
            margin-bottom: 25px;
        }

        .message {
            padding: 12px 15px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        .success-message {
            background-color: #dff6dd;
            border: 1px solid #82c77d;
        }

        .error-message {
            background-color: #ffe0e0;
            border: 1px solid #e58a8a;
        }

        .search-form {
            background-color: white;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 25px;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr auto auto;
            gap: 12px;
            align-items: center;
        }

        .search-form input,
        .search-form select {
            width: 100%;
            padding: 10px;
            border: 1px solid #bbb;
            border-radius: 5px;
            font-size: 15px;
        }

        .button {
            display: inline-block;
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            text-decoration: none;
            cursor: pointer;
            font-size: 14px;
        }

        .primary-button {
            background-color: #4c55d9;
            color: white;
        }

        .secondary-button {
            background-color: #666;
            color: white;
        }

        .join-button {
            background-color: #198754;
            color: white;
        }

        .leave-button {
            background-color: #c0392b;
            color: white;
        }

        .disabled-button {
            background-color: #aaa;
            color: white;
            cursor: not-allowed;
        }

        .events-grid {
            display: grid;
            grid-template-columns: repeat(
                auto-fit,
                minmax(280px, 1fr)
            );
            gap: 20px;
        }

        .event-card {
            background-color: white;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
        }

        .event-card h2 {
            margin-top: 0;
            margin-bottom: 12px;
        }

        .event-card p {
            margin: 8px 0;
            line-height: 1.4;
        }

        .event-type {
            display: inline-block;
            padding: 5px 9px;
            margin-bottom: 10px;
            border-radius: 14px;
            background-color: #e8e9ff;
            color: #3036a5;
            font-size: 13px;
        }

        .event-actions {
            margin-top: 18px;
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        .event-actions form {
            margin: 0;
        }

        .no-events {
            background-color: white;
            padding: 25px;
            border-radius: 8px;
            text-align: center;
        }

       
    
    </style>
</head>

<body>

    <nav>
        <a class="brand" href="/">Gaming Event Planner</a>

        <div class="links">
            <a href="/events">Browse Events</a>

            <% if (user) { %>
                <a href="/joined-events">Joined Events</a>
                <a href="/dashboard">Dashboard</a>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </div>
    </nav>

    <main class="container">

        <h1>Browse Gaming Events</h1>

        <p class="page-description">
            Find gaming tournaments, ranked sessions,
            casual matches and training activities.
        </p>

        <% if (success === 'joined') { %>
            <div class="message success-message">
                You successfully joined the event.
            </div>
        <% } %>

        <% if (success === 'left') { %>
            <div class="message success-message">
                You successfully left the event.
            </div>
        <% } %>

        <% if (error === 'full') { %>
            <div class="message error-message">
                This event is already full.
            </div>
        <% } %>

        <% if (error === 'alreadyJoined') { %>
            <div class="message error-message">
                You have already joined this event.
            </div>
        <% } %>

        <% if (error === 'eventNotFound') { %>
            <div class="message error-message">
                The selected event could not be found.
            </div>
        <% } %>

        <form
            class="search-form"
            action="/events"
            method="GET"
        >
            <input
                type="text"
                name="search"
                placeholder="Search by event title or game"
                value="<%= search || '' %>"
            >

            <select name="platform">
                <option value="">All Platforms</option>

                <option
                    value="PC"
                    <%= platform === 'PC' ? 'selected' : '' %>
                >
                    PC
                </option>

                <option
                    value="PlayStation"
                    <%= platform === 'PlayStation'
                        ? 'selected'
                        : ''
                    %>
                >
                    PlayStation
                </option>

                <option
                    value="Xbox"
                    <%= platform === 'Xbox'
                        ? 'selected'
                        : ''
                    %>
                >
                    Xbox
                </option>

                <option
                    value="Mobile"
                    <%= platform === 'Mobile'
                        ? 'selected'
                        : ''
                    %>
                >
                    Mobile
                </option>

                <option
                    value="Nintendo Switch"
                    <%= platform === 'Nintendo Switch'
                        ? 'selected'
                        : ''
                    %>
                >
                    Nintendo Switch
                </option>
            </select>

            <select name="eventType">
                <option value="">All Event Types</option>

                <option
                    value="Tournament"
                    <%= eventType === 'Tournament'
                        ? 'selected'
                        : ''
                    %>
                >
                    Tournament
                </option>

                <option
                    value="Ranked"
                    <%= eventType === 'Ranked'
                        ? 'selected'
                        : ''
                    %>
                >
                    Ranked Session
                </option>

                <option
                    value="Casual"
                    <%= eventType === 'Casual'
                        ? 'selected'
                        : ''
                    %>
                >
                    Casual Match
                </option>

                <option
                    value="Training"
                    <%= eventType === 'Training'
                        ? 'selected'
                        : ''
                    %>
                >
                    Training Session
                </option>
            </select>

            <button
                class="button primary-button"
                type="submit"
            >
                Search
            </button>

            <a
                class="button secondary-button"
                href="/events"
            >
                Clear
            </a>
        </form>

        <% if (!events || events.length === 0) { %>

            <div class="no-events">
                <h2>No events found</h2>

                <p>
                    Try using another keyword or changing
                    the selected filters.
                </p>
            </div>

        <% } else { %>

            <section class="events-grid">

                <% events.forEach(event => { %>

                    <article class="event-card">

                        <span class="event-type">
                            <%= event.eventType %>
                        </span>

                        <h2><%= event.title %></h2>

                        <p>
                            <strong>Game:</strong>
                            <%= event.gameName %>
                        </p>

                        <p>
                            <strong>Platform:</strong>
                            <%= event.platform %>
                        </p>

                        <p>
                            <strong>Date:</strong>

                            <%= new Date(
                                event.eventDate
                            ).toLocaleDateString('en-SG') %>
                        </p>

                        <p>
                            <strong>Time:</strong>
                            <%= event.eventTime %>
                        </p>

                        <p>
                            <strong>Location/Server:</strong>
                            <%= event.location || 'Not specified' %>
                        </p>

                        <p>
                            <strong>Players:</strong>
                            <%= event.currentPlayers %>
                            /
                            <%= event.maxPlayers %>
                        </p>

                        <% if (event.description) { %>
                            <p>
                                <strong>Description:</strong>
                                <%= event.description %>
                            </p>
                        <% } %>

                        <div class="event-actions">

                            <% if (!user) { %>

                                <a
                                    class="button primary-button"
                                    href="/login"
                                >
                                    Login to Join
                                </a>

                            <% } else if (event.hasJoined) { %>

                                <form
                                    action="/events/<%= event.eventId %>/leave"
                                    method="POST"
                                >
                                    <button
                                        class="button leave-button"
                                        type="submit"
                                    >
                                        Leave Event
                                    </button>
                                </form>

                            <% } else if (
                                Number(event.currentPlayers) >=
                                Number(event.maxPlayers)
                            ) { %>

                                <button
                                    class="button disabled-button"
                                    type="button"
                                    disabled
                                >
                                    Event Full
                                </button>

                            <% } else { %>

                                <form
                                    action="/events/<%= event.eventId %>/join"
                                    method="POST"
                                >
                                    <button
                                        class="button join-button"
                                        type="submit"
                                    >
                                        Join Event
                                    </button>
                                </form>

                            <% } %>

                        </div>

                    </article>

                <% }) %>

            </section>

        <% } %>

    </main>

</body>
</html>