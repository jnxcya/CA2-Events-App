<!DOCTYPE html>
<html>
<head>

    <title>Dashboard</title>

    <link rel="stylesheet" href="/css/stylesheet.css">

    <style>

        body{

            background:#111827;
            color:white;
            font-family:Arial;

        }

        .container{

            width:900px;
            margin:80px auto;
            text-align:center;

        }

        .cards{

            display:grid;
            grid-template-columns:repeat(2,1fr);
            gap:20px;
            margin-top:40px;

        }

        .card{

            background:#1f2937;
            padding:30px;
            border-radius:15px;

        }

        .card a{

            color:white;
            text-decoration:none;
            font-size:20px;

        }

    </style>

</head>

<body>

<div class="container">

    <h1>Dashboard</h1>

    <p>Welcome back <b><%= user.username %></b></p>

    <div class="cards">

        <div class="card">

            <a href="/user-dashboard">

                👤 User Dashboard

            </a>

        </div>

        <div class="card">

            <a href="/profile">

                👤 My Profile

            </a>

        </div>

        <div class="card">

            <a href="/statistics">

                📊 Statistics

            </a>

        </div>

        <div class="card">

            <a href="/events">

                🎮 Browse Events

            </a>

        </div>

        <% if(user.role==="admin"){ %>

        <div class="card">

            <a href="/admin">

                ⚙ Admin Dashboard

            </a>

        </div>

        <% } %>

    </div>

</div>

</body>

</html>
