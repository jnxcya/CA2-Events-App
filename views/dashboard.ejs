<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Gaming Event Planner</title>

    <link rel="stylesheet" href="/css/stylesheet.css">

    <style>

        body{
            background:#111827;
            color:white;
            font-family:Arial, Helvetica, sans-serif;
        }

        .dashboard{

            width:90%;
            max-width:1200px;
            margin:40px auto;

        }

        .welcome{

            margin-bottom:30px;

        }

        .welcome h1{

            font-size:35px;

        }

        .cards{

            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
            gap:20px;
            margin-bottom:40px;

        }

        .card{

            background:#1f2937;
            border-radius:15px;
            padding:25px;
            text-align:center;
            box-shadow:0 5px 15px rgba(0,0,0,.4);

        }

        .card h2{

            font-size:40px;
            color:#38bdf8;

        }

        .card p{

            font-size:18px;

        }

        .section{

            margin-top:30px;

        }

        table{

            width:100%;
            border-collapse:collapse;
            background:#1f2937;
            border-radius:10px;
            overflow:hidden;

        }

        th{

            background:#2563eb;
            padding:15px;

        }

        td{

            padding:15px;
            border-bottom:1px solid #374151;

        }

        .quick-actions{

            display:flex;
            gap:15px;
            flex-wrap:wrap;
            margin-top:30px;

        }

        .quick-actions a{

            text-decoration:none;
            color:white;
            background:#2563eb;
            padding:12px 25px;
            border-radius:8px;

        }

        .quick-actions a:hover{

            background:#1d4ed8;

        }

        nav{

            background:#1f2937;
            padding:20px;
            display:flex;
            justify-content:space-between;

        }

        nav a{

            color:white;
            text-decoration:none;
            margin-left:20px;

        }

        .brand{

            font-size:22px;
            font-weight:bold;

        }

    </style>

</head>

<body>

<nav>

    <a class="brand" href="/">🎮 Gaming Event Planner</a>

    <div>

        <a href="/events">Browse Events</a>

        <a href="/events/add">Create Event</a>

        <a href="/my-events">My Events</a>

        <a href="/joined-events">Joined Events</a>

        <a href="/statistics">Statistics</a>

        <a href="/profile">Profile</a>

        <a href="/logout">Logout</a>

    </div>

</nav>


<div class="dashboard">

    <div class="welcome">

        <h1>Welcome Back, <%= user.username %> 👋</h1>

        <p>Manage your gaming events from your dashboard.</p>

    </div>


    <div class="cards">

        <div class="card">

            <h2><%= totalCreated %></h2>

            <p>Events Created</p>

        </div>


        <div class="card">

            <h2><%= totalJoined %></h2>

            <p>Events Joined</p>

        </div>


        <div class="card">

            <h2><%= upcomingEvents.length %></h2>

            <p>Upcoming Events</p>

        </div>

    </div>


    <div class="section">

        <h2>Your Upcoming Events</h2>

        <% if(upcomingEvents.length===0){ %>

            <p>You have no upcoming events.</p>

        <% } else { %>

        <table>

            <tr>

                <th>Title</th>

                <th>Game</th>

                <th>Date</th>

                <th>Time</th>

                <th>Platform</th>

            </tr>

            <% upcomingEvents.forEach(event=>{ %>

            <tr>

                <td><%= event.title %></td>

                <td><%= event.gameName %></td>

                <td><%= new Date(event.eventDate).toLocaleDateString('en-SG') %></td>

                <td><%= event.eventTime %></td>

                <td><%= event.platform %></td>

            </tr>

            <% }) %>

        </table>

        <% } %>

    </div>


    <div class="quick-actions">

        <a href="/events">Browse Events</a>

        <a href="/events/add">Create Event</a>

        <a href="/my-events">My Events</a>

        <a href="/joined-events">Joined Events</a>

        <a href="/statistics">Statistics</a>

        <a href="/profile">My Profile</a>

        <% if(user.role==="admin"){ %>

            <a href="/admin">Admin Panel</a>

        <% } %>

    </div>

</div>

</body>

</html>
