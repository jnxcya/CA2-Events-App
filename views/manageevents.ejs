<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Events</title>
    <link rel="stylesheet" href="/stylesheet.css">
</head>

<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand">
        <div class="admin-container">
            <a class="navbar-brand" href="/admin">
                Game Events Admin
            </a>
            <ul class="admin-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/admindashboard">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/users">Manage Users</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/manageevents">Manage Events</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/logout">Logout</a>
                </li>
            </ul>
        </div>
    </nav>
    <div class="manage-page">
        <!-- Header -->
        <div class="manage-card">
            <h1>Manage Events</h1>
            <p>View and manage all gaming events</p>
        </div>
        <!-- Reported Events -->
        <div class="manage-card">
            <h2>Reported Events</h2>
            <% const reportedEvents = events.filter(event => event.reported == 1); %>
            <% if(reportedEvents.length === 0){ %>
                <p class="empty-text">No reported events found!</p>
            <% } else { %>
            <table class="eventadmintable">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Game</th>
                        <th>Creator</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                <% reportedEvents.forEach(event => { %>
                    <tr>
                        <td><%= event.title %></td>
                        <td><%= event.gameName %></td>
                        <td><%= event.username %></td>
                        <td>
                            <a href="/admin/deleteEvent/<%= event.eventId %>"
                                class="eventdelete-btn"
                                onclick="return confirm('Delete this reported event?')">Delete</a>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
            <% } %>
        </div>
        <!-- All Events -->
        <div class="event-card">
            <h2>All Events</h2>
            <table class="eventadmintable">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Game</th>
                        <th>Platform</th>
                        <th>Date</th>
                        <th>Creator</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                <% events.forEach(event => { %>
                    <tr>
                        <td><%= event.title %></td>
                        <td><%= event.gameName %></td>
                        <td><%= event.platform %></td>
                        <td><%= event.eventDate.toDateString() %></td>
                        <td><%= event.username %></td>
                        <td>
                            <% if(event.reported == 1){ %>
                                <span class="status reported">Reported</span>
                            <% } else { %>
                                <span class="status normal">Normal</span>
                            <% } %>
                        </td>
                        <td>
                            <% if(event.reported == 0){ %>
                                <a href="/admin/reportEvent/<%= event.eventId %>"
                                    class="report-btn"
                                    onclick="return confirm('Mark this event as reported?')">Report</a>
                            <% } %>
                            <a href="/admin/deleteEvent/<%= event.eventId %>"
                                class="eventdelete-btn"
                                onclick="return confirm('Delete this event?')">
                                Delete
                            </a>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>