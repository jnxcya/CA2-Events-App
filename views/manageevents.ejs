<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Events</title>
    <link rel="stylesheet" href="/stylesheet.css">
</head>

<body>
    <!-- Navigation Bar -->
    <nav class="navbar navrbar-expand">
        <div class="admin-container">
            <a class="navbar-brand" href="/admin">
                Game Events Admin
            </a>
            <ul class="admin-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/dashboard">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/users">Manage Users</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/manageevents">Manage Events</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/logout">Logout</a>
                </li>
            </ul>
        </div>
    </nav>
    <!--Page Header-->
    <div class="events">
        <h1>
            Manage Events
        </h1>
        <p class="events-subtitle">
            View and manage all events
        </p>
    </div>
    <!--Reported Events-->
    <div class="events-table">
        <h2>Reported Events</h2>
        <% events.forEach(event=> { %>
            <p>No reported events found.</p>
            <% }); %>
    </div>
    <!-- All Events -->
     <div class="events-table">
        <h2>All Events</h2>
        <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Game</th>
                <th>Platform</th>
                <th>Date</th>
                <th>Creator</th>
                <th>Actions</th>
            </tr>  
            </thead>
            <tbody>
                <% events.forEach(event => { %>
                    <tr>
                        <td><%= event.title %></td>
                        <td><%= event.gameName %></td>
                        <td><%= event.platform %></td>
                        <td><%= event.eventDate.toDateString() %></td>
                        <td><%= event.username %></td>

                        <td>
                            <a href="/admin/editEvent/<%= event.eventId %>"
                                class="edit-btn">Edit</a>
                            <a href="/admin/deleteEvent/<%= event.eventId %>"
                                class="delete-btn">Delete</a>
                        </td>
                    </tr>
                <%}) %>
            </tbody>
        </table>
     </div>
</body>
</html>