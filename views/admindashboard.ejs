<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/stylesheet.css">
</head>

<body>
    <!-- Navigation Bar -->
    <nav class="navbar navrbar-expand">
        <div class="admin-container">
            <a class="navbar-brand" href="/admin">
                Game Events Admin
            </a>
            <ul class="admin-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/admindashboard">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/users">Manage Users</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/manageevents">Manage Events</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/logout">Logout</a>
                </li>
            </ul>
        </div>
    </nav>
    <!-- Dashboard Content -->
    <div class="admindashboard">
        <div class="admin-daashboard">
            <h1>Admin Dashboard</h1>
            <h5>Welcome back, <%= user.username %>!</h5>
            <p>Role: <%= user.role %>
            </p>
        </div>
    </div>
    <div class="admin-row">
        <div class="adminrow">
            <div class="admincard">
                <div class="adminnumber">
                    <%= totalUsers %>
                </div>
                <h3>Total Users</h3>
            </div>
        </div>
        <div class="adminrow">
            <div class="admincard">
                <div class="adminnumber">
                    <%= totalEvents %>
                </div>
                <h3>Total Events</h3>
            </div>
        </div>
    </div>
    <!-- Report -->
    <div class="cardadmin">
        <h2>Total Report</h2>
        <div class="report-grid">
            <div class="report-card">
                <h3>Total Members</h3>
                <div class="report-number">
                    <%= totalUsers %>
                </div>
            </div>
            <div class="report-card">
                <h3>Total Events</h3>
                <div class="report-number">
                    <%= totalEvents %>
                </div>
            </div>
            <div class="report-card">
                <h3>Total Records</h3>
                <div class="report-number total-records">
                    <%= totalReport %>
                </div>
            </div>
        </div>
    </div>
    <div class="cardadmin">
        <h2> Recent Events</h2>
        <span class="badge"><%= recentEvents.length %></span>
    </div>
    <table class="recent-events-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Game</th>
                <th>Platform</th>
                <th>Date</th>
                <th>Creator</th>
            </tr>
        </thead>
        <tbody>
            <% if(recentEvents.length === 0) { %>
                <tr>
                    <td colspan="5" class="empty-text">
                        No recent events found.
                    </td>
                </tr>
            <%} else { %>
                <% recentEvents.forEach(event => { %>
                <tr>
                    <td>
                        <strong><%= event.title %></strong>
                    </td>
                    <td>
                        <span class="game-tag">
                            <%= event.gameName %>
                        </span>
                    </td>
                    <td>
                        <%= event.platform %>
                    </td>
                    <td>
                        <%= event.eventDate.toLocaleDateString('en-SG') %>
                    </td>
                    <td>
                        <%= event.username %>
                    </td>
                </tr>
                <%})%>
            <%} %>
        </tbody>
    </table>
</body>

</html>