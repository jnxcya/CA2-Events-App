<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Joined Events</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <nav>
        <h2>Gaming Event Planner</h2>

        <div>
            <a href="/dashboard">Dashboard</a>
            <a href="/events">Browse Events</a>
            <a href="/joined-events">Joined Events</a>
            <a href="/logout">Logout</a>
        </div>
    </nav>

    <main class="container">

        <h1>My Joined Events</h1>

        <p>
            These are the gaming events that you have joined.
        </p>

        <% if (messages && messages.length > 0) { %>

            <% messages.forEach(message => { %>
                <div class="message success">
                    <%= message %>
                </div>
            <% }) %>

        <% } %>

        <% if (errors && errors.length > 0) { %>

            <% errors.forEach(error => { %>
                <div class="message error">
                    <%= error %>
                </div>
            <% }) %>

        <% } %>

        <a class="browse-button" href="/events">
            Browse More Events
        </a>

        <% if (!events || events.length === 0) { %>

            <div class="empty-message">
                <h2>No joined events</h2>

                <p>
                    You have not joined any events yet.
                </p>
            </div>

        <% } else { %>

            <section class="events-grid">

                <% events.forEach(event => { %>

                    <article class="event-card">

                        <h2><%= event.title %></h2>

                        <p>
                            <strong>Game:</strong>
                            <%= event.gameName %>
                        </p>

                        <p>
                            <strong>Platform:</strong>
                            <%= event.platform %>
                        </p>

                        <p>
                            <strong>Event Type:</strong>
                            <%= event.eventType %>
                        </p>

                        <p>
                            <strong>Date:</strong>

                            <%= new Date(
                                event.eventDate
                            ).toLocaleDateString('en-SG') %>
                        </p>

                        <p>
                            <strong>Time:</strong>
                            <%= event.eventTime %>
                        </p>

                        <p>
                            <strong>Location:</strong>
                            <%= event.location %>
                        </p>

                        <% if (event.description) { %>

                            <p>
                                <strong>Description:</strong>
                                <%= event.description %>
                            </p>

                        <% } %>

                        <p>
                            <strong>Joined on:</strong>

                            <%= new Date(
                                event.joinedAt
                            ).toLocaleString('en-SG') %>
                        </p>

                        <form
                            action="/events/<%= event.eventId %>/leave"
                            method="POST"
                        >
                            <button
                                class="leave-button"
                                type="submit"
                            >
                                Leave Event
                            </button>
                        </form>

                    </article>

                <% }) %>

            </section>

        <% } %>

    </main>

</body>
</html>