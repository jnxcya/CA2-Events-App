<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Joined Events</title>

    <link rel="stylesheet" href="/stylesheet.css">

    <style>
        /* Headings sit on the dark page background */
        .container h1,
        .container .page-description,
        .container .page-label {
            color: #f4f4f4;
        }

        /* Text inside the white event cards */
        .event-card,
        .event-card h2,
        .event-card p,
        .event-card strong,
        .event-card span {
            color: #222;
        }

        /* Small label above each detail value */
        .detail-label {
            display: block;
            color: #666;
            font-size: 13px;
        }
    </style>
</head>

<body>

    <nav>
        <a class="brand" href="/">Gaming Event Planner</a>

        <div class="links">
            <a href="/events">Browse Events</a>
            <a href="/events/add">Create Event</a>
            <a href="/my-events">My Events</a>
            <a href="/joined-events">Joined Events</a>
            <a href="/userdashboard">Dashboard</a>
            <a href="/statistics">Statistics</a>
            <a href="/profile">Profile</a>
            <a href="/logout">Logout</a>
        </div>
    </nav>

    <main class="container">

        <p class="page-label">Event Discovery</p>

        <h1>My Joined Events</h1>

        <p class="page-description">
            View and manage the gaming events that you have joined.
        </p>

        <% if (messages && messages.length > 0) { %>
        <% messages.forEach(function (message) { %>
        <div class="message success-message"><%= message %></div>
        <% }); %>
        <% } %>

        <% if (errors && errors.length > 0) { %>
        <% errors.forEach(function (error) { %>
        <div class="message error-message"><%= error %></div>
        <% }); %>
        <% } %>

        <% if (!events || events.length === 0) { %>

        <div class="no-events">
            <h2>No joined events yet</h2>
            <p>
                You have not joined any gaming events yet. Browse the available
                events and join one that interests you.
            </p>
            <a class="button primary-button" href="/events">Explore Events</a>
        </div>

        <% } else { %>

        <section class="events-grid">

            <% events.forEach(function (event) { %>

            <article class="event-card">

                <span class="event-type"><%= event.eventType || 'Gaming Event' %></span>

                <h2><%= event.title %></h2>

                <p><%= event.description || 'No description provided.' %></p>

                <p><strong>Game:</strong> <%= event.gameName || 'Not specified' %></p>

                <p><strong>Platform:</strong> <%= event.platform || 'Not specified' %></p>

                <p>
                    <strong>Date:</strong>
                    <% if (event.eventDate) { %>
                    <%= new Date(event.eventDate).toLocaleDateString('en-SG') %>
                    <% } else { %>
                    Not specified
                    <% } %>
                </p>

                <p><strong>Time:</strong> <%= event.eventTime || 'Not specified' %></p>

                <p><strong>Location/Server:</strong> <%= event.location || 'Not specified' %></p>

                <p><strong>Players:</strong> <%= event.currentPlayers || 0 %> / <%= event.maxPlayers || 0 %></p>

                <% if (event.joinedAt) { %>
                <p><strong>Joined on:</strong> <%= new Date(event.joinedAt).toLocaleDateString('en-SG') %></p>
                <% } %>

                <div class="event-actions">

                    <form action="/events/<%= event.eventId %>/leave" method="POST" onsubmit="return confirm('Are you sure you want to leave this event?');">
                        <button class="button leave-button" type="submit">Leave Event</button>
                    </form>

                </div>

            </article>

            <% }); %>

        </section>

        <% } %>

    </main>

</body>

</html>
