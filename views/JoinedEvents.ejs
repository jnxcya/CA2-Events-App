<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Joined Events</title>

    <link rel="stylesheet" href="/stylesheet.css">
</head>

<body class="joined-page">

    <nav class="joined-navbar">

        <a href="/" class="joined-logo">
            Gaming Event Planner
        </a>

        <div class="joined-nav-links">
            <a href="/dashboard">
                Dashboard
            </a>

            <a href="/events">
                Browse Events
            </a>

            <a href="/joined-events" class="active">
                Joined Events
            </a>

            <a href="/logout">
                Logout
            </a>
        </div>

    </nav>

    <main class="joined-container">

        <header class="joined-page-header">

            <div class="joined-header-text">

                <p class="joined-label">
                    Event Discovery
                </p>

                <h1>My Joined Events</h1>

                <p class="joined-description">
                    View and manage the gaming events that you have joined.
                </p>

            </div>

            <a
                href="/events"
                class="joined-browse-button"
            >
                Browse More Events
            </a>

        </header>

        <% if (messages && messages.length > 0) { %>

            <% messages.forEach(message => { %>

                <div class="joined-alert joined-success">
                    <%= message %>
                </div>

            <% }) %>

        <% } %>

        <% if (errors && errors.length > 0) { %>

            <% errors.forEach(error => { %>

                <div class="joined-alert joined-error">
                    <%= error %>
                </div>

            <% }) %>

        <% } %>

        <% if (!events || events.length === 0) { %>

            <section class="joined-empty-card">

                <div class="joined-empty-icon">
                    🎮
                </div>

                <h2>No joined events yet</h2>

                <p>
                    You have not joined any gaming events yet.
                    Browse the available events and join one that
                    interests you.
                </p>

                <a
                    href="/events"
                    class="joined-browse-button"
                >
                    Explore Events
                </a>

            </section>

        <% } else { %>

            <section class="joined-events-grid">

                <% events.forEach(event => { %>

                    <article class="joined-event-card">

                        <div class="joined-card-top">

                            <span class="joined-type-badge">
                                <%= event.eventType || 'Gaming Event' %>
                            </span>

                            <span class="joined-status">
                                Joined
                            </span>

                        </div>

                        <h2 class="joined-event-title">
                            <%= event.title %>
                        </h2>

                        <p class="joined-event-description">
                            <%= event.description || 'No description provided.' %>
                        </p>

                        <div class="joined-event-details">

                            <div class="joined-detail-item">

                                <span class="joined-detail-label">
                                    Game
                                </span>

                                <strong>
                                    <%= event.gameName || 'Not specified' %>
                                </strong>

                            </div>

                            <div class="joined-detail-item">

                                <span class="joined-detail-label">
                                    Platform
                                </span>

                                <strong>
                                    <%= event.platform || 'Not specified' %>
                                </strong>

                            </div>

                            <div class="joined-detail-item">

                                <span class="joined-detail-label">
                                    Date
                                </span>

                                <strong>
                                    <% if (event.eventDate) { %>

                                        <%= new Date(
                                            event.eventDate
                                        ).toLocaleDateString('en-SG') %>

                                    <% } else { %>

                                        Not specified

                                    <% } %>
                                </strong>

                            </div>

                            <div class="joined-detail-item">

                                <span class="joined-detail-label">
                                    Time
                                </span>

                                <strong>
                                    <%= event.eventTime || 'Not specified' %>
                                </strong>

                            </div>

                            <div class="joined-detail-item">

                                <span class="joined-detail-label">
                                    Location / Server
                                </span>

                                <strong>
                                    <%= event.location || 'Not specified' %>
                                </strong>

                            </div>

                            <div class="joined-detail-item">

                                <span class="joined-detail-label">
                                    Players
                                </span>

                                <strong>
                                    <%= event.currentPlayers || 0 %>
                                    /
                                    <%= event.maxPlayers || 0 %>
                                </strong>

                            </div>

                            <% if (event.joinedAt) { %>

                                <div class="joined-detail-item">

                                    <span class="joined-detail-label">
                                        Joined on
                                    </span>

                                    <strong>
                                        <%= new Date(
                                            event.joinedAt
                                        ).toLocaleDateString('en-SG') %>
                                    </strong>

                                </div>

                            <% } %>

                        </div>

                        <footer class="joined-card-footer">

                            <form
                                action="/events/<%= event.eventId %>/leave"
                                method="POST"
                                onsubmit="return confirm('Are you sure you want to leave this event?');"
                            >
                                <button
                                    type="submit"
                                    class="joined-leave-button"
                                >
                                    Leave Event
                                </button>
                            </form>

                        </footer>

                    </article>

                <% }) %>

            </section>

        <% } %>

    </main>

</body>

</html>